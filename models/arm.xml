<mujoco model="double_pendulum">

    <option gravity="0 0 -9.81"/>

    <worldbody>

        <geom name="wall" type="box" pos="-0.05 0 1" size="0.05 1 1.5" rgba="0.6 0.6 0.6 1"/>

        <body name="base" pos="0 0 1" euler="0 90 0">

            <geom name="mount" type="cylinder" size="0.2 0.1"/>

            <body name="link1" pos="0 0 0.1">

                <joint name="joint1" type="hinge" axis="0 0 1"/>

                <geom name="link1_geom" type="capsule" fromto="0 0 0 1 0 0" size="0.08" rgba="0.2 0.4 0.8 1"/>

                <!-- link2's origin = exactly the tip of link1. This is correct, not a bug. -->
                <body name="link2" pos="1 0 0.3">

                    <!-- Same axis as joint1 -> both links swing in the same plane -->
                    <joint name="joint2" type="hinge" axis="0 0 1"/>

                    <geom name="link2_geom" type="capsule" fromto="0 0 0 1 0 0" size="0.06" rgba="0.8 0.3 0.2 1"/>

                    <geom name="end_effector" type="sphere" pos="1 0 0" size="0.1" mass="2"/>

                </body>

            </body>

        </body>

    </worldbody>

    <actuator>
        <motor name="motor1" joint="joint1" gear="10"/>
        <motor name="motor2" joint="joint2" gear="10"/>
    </actuator>

</mujoco>